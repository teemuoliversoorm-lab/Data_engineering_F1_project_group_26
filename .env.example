# Local development. Copy to .env and change passwords before sharing a host.
POSTGRES_DB=f1_warehouse
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1_local_change_me
POSTGRES_PORT=5433
AIRFLOW_DB_PASSWORD=airflow_local_change_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_local_change_me
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=local_development_change_me

# Needed for the DAG's build_warehouse task (DockerOperator) to access
# /var/run/docker.sock. On native Linux, find your host's docker group GID
# with terminal commands: 

# 1. bring the stack up (default DOCKER_GID=999 applies if .env lacks it)
# docker compose up -d

# 2. read the socket's actual group GID inside the container
# docker compose exec airflow-scheduler stat -c %g /var/run/docker.sock

# 3. if it isn't 999, set DOCKER_GID=<that number> in .env, then recreate:
# docker compose up -d

# 4. verify the scheduler picked up the supplementary group
# docker compose exec airflow-scheduler id

# On Docker Desktop (Windows/Mac) the default usually works unchanged.
DOCKER_GID=999
